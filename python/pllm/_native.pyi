from typing import Any, Never, final

class Matrix:
    def __init__(self, data: bytes, rows: int, cols: int) -> None: ...
    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def weight_bytes(self) -> int: ...

@final
class CompiledPlan:
    def __new__(cls) -> Never: ...
    @property
    def logical_plan(self) -> bytes: ...
    @property
    def execution_plan(self) -> bytes: ...
    @property
    def plan_lock(self) -> bytes: ...
    @property
    def region_program(self) -> bytes: ...
    @property
    def configuration_digest(self) -> str: ...
    @property
    def logical_plan_digest(self) -> str: ...
    @property
    def execution_plan_digest(self) -> str: ...
    @property
    def plan_lock_digest(self) -> str: ...
    @property
    def input_shape(self) -> tuple[int, ...]: ...
    @property
    def output_shape(self) -> tuple[int, ...]: ...
    def execute_wrap32(
        self,
        weights: bytes,
        input: bytes,
        threads: int = 1,
        simd: bool = True,
    ) -> bytes: ...
    def benchmark_wrap32(
        self,
        weights: bytes,
        input: bytes,
        benchmark_id: str,
        privacy_cohort: str,
        numeric_cohort: str,
        environment: bytes,
        warmups: int = 3,
        repetitions: int = 10,
        threads: int = 1,
        simd: bool = True,
    ) -> bytes: ...

@final
class ResolvedExperimentComposition:
    def __new__(cls) -> Never: ...
    @property
    def canonical_composition(self) -> bytes: ...
    @property
    def composition_digest(self) -> str: ...
    @property
    def configuration_digest(self) -> str: ...
    @property
    def model(self) -> str: ...

@final
class GatedMultiplyQ7Region:
    def __new__(cls) -> Never: ...
    @property
    def digest(self) -> str: ...
    @property
    def multiply_operation_id(self) -> str: ...
    @property
    def method_component_id(self) -> str: ...
    @property
    def schedule_component_id(self) -> str: ...
    @property
    def max_tensor_elements(self) -> int: ...
    def prepare_material(self) -> GarbledGatedMultiplyQ7Material: ...
    def prepare_evaluator(self, payload: bytes) -> GatedMultiplyQ7Evaluator: ...

@final
class GarbledGatedMultiplyQ7Material:
    def __new__(cls) -> Never: ...
    @property
    def evaluator_payload(self) -> bytes: ...
    @property
    def element_count(self) -> int: ...
    def cancel(self) -> bool: ...
    def encode_gate(self, value: int) -> bytes: ...
    def encode_up(self, value: int) -> bytes: ...
    def decode(self, label: bytes) -> int: ...
    def encode_gates(self, values: object) -> tuple[bytes, ...]: ...
    def encode_ups(self, values: object) -> tuple[bytes, ...]: ...
    def decode_tensor(self, labels: object) -> list[int]: ...

@final
class GatedMultiplyQ7Evaluator:
    def __new__(cls) -> Never: ...
    def evaluate(self, gate_label: bytes, up_label: bytes) -> bytes: ...
    def evaluate_tensor(self, gate_labels: object, up_labels: object) -> tuple[bytes, ...]: ...

@final
class FreivaldsPolicy:
    def __init__(
        self,
        target_failure_bits: int,
        max_attempts: int,
        max_matrix_elements: int,
        max_projection_elements: int,
        max_challenge_elements: int,
        max_output_elements: int,
        max_multiply_accumulates: int,
        max_batch_rows: int,
        session_id: bytes,
        register_session: bool,
    ) -> None: ...
    @property
    def checks(self) -> int: ...
    @property
    def target_failure_bits(self) -> int: ...
    @property
    def max_attempts(self) -> int: ...
    @property
    def conservative_failure_bits(self) -> int: ...

@final
class FreivaldsProjectionInventory:
    @property
    def material_id(self) -> bytes: ...
    def __new__(cls) -> Never: ...
    @property
    def inventory_rows(self) -> int: ...
    @property
    def in_features(self) -> int: ...
    @property
    def out_features(self) -> int: ...
    @property
    def checks(self) -> int: ...
    @property
    def max_row_l1(self) -> int: ...
    def payload(self) -> bytes: ...
    def authentication_tag(self, root_seed: bytes) -> bytes: ...
    def claim(
        self,
        root_seed: bytes,
        binding: bytes,
        row_start: int,
        batch_rows: int,
    ) -> FreivaldsVerifier: ...
    def cancel(self) -> bool: ...

@final
class FreivaldsVerifier:
    def __new__(cls) -> Never: ...
    def verify(self, input: bytes, output: bytes) -> bytes: ...
    def cancel(self) -> bool: ...

class Executor:
    def __init__(self, threads: int = 1, simd: bool = True) -> None: ...
    @property
    def threads(self) -> int: ...
    @property
    def simd(self) -> bool: ...
    def modular(self, matrix: Matrix, input: bytes, batch: int, modulus: int) -> bytes: ...
    def wrap32(self, matrix: Matrix, input: bytes, batch: int) -> bytes: ...
    def wrap64(self, matrix: Matrix, input: bytes, batch: int) -> bytes: ...
    def clear(self, matrix: Matrix, input: bytes, batch: int) -> bytes: ...
    def coefficients(self, matrix: Matrix, input: bytes, columns: int, modulus: int) -> bytes: ...

def capabilities() -> dict[str, Any]: ...
def compile_plan(document: bytes) -> CompiledPlan: ...
def resolve_experiment(document: bytes) -> ResolvedExperimentComposition: ...
def assurance_report() -> bytes: ...
def assurance_results() -> bytes: ...
def lower_model(
    config: bytes,
    batch: int,
    max_input_tokens: int,
    max_new_tokens: int,
) -> bytes: ...
def decoder_coverage(plan: bytes, composition: bytes | None = ...) -> bytes: ...
def decoder_runtime_schedule(plan: bytes, composition: bytes) -> tuple[bytes, str]: ...
def lower_gated_multiply_q7(
    plan: bytes,
    mode: str,
    method_component_id: str = "pllm/r03-crt/v1",
    schedule_component_id: str = "pllm/scalar/v1",
    max_tensor_elements: int = 1,
) -> list[GatedMultiplyQ7Region]: ...
def apply_model_component(plan: bytes, component: bytes) -> bytes: ...
def deployment_benchmark_report(document: bytes) -> bytes: ...
def pack_unsigned(input: bytes, width: int) -> bytes: ...
def unpack_unsigned(input: bytes, width: int) -> bytes: ...
def mask(input: bytes, masks: bytes, modulus: int) -> bytes: ...
def unmask(input: bytes, masks: bytes, modulus: int) -> bytes: ...
def quantize(
    input: bytes, rows: int, cols: int, bits: int = 4, scales: bytes | None = None
) -> tuple[bytes, bytes]: ...
def uniform_residues(modulus: int, count: int) -> bytes: ...
def prepare_freivalds(
    weights: bytes,
    out_features: int,
    in_features: int,
    inventory_rows: int,
    root_seed: bytes,
    binding: bytes,
    material_id: bytes,
    signed_input_bound: int,
    signed_output_bound: int,
    policy: FreivaldsPolicy,
) -> FreivaldsProjectionInventory: ...
def import_freivalds(
    payload: bytes,
    authentication_tag: bytes,
    root_seed: bytes,
    inventory_rows: int,
    in_features: int,
    out_features: int,
    binding: bytes,
    material_id: bytes,
    signed_input_bound: int,
    signed_output_bound: int,
    max_row_l1: int,
    policy: FreivaldsPolicy,
) -> FreivaldsProjectionInventory: ...
