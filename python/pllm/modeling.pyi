from collections.abc import Mapping
from typing import Any

from pllm.configuration import ComponentRef, Pipeline

class ModelPlan:
    def __init__(self, _canonical_bytes: bytes) -> None: ...
    @property
    def digest(self) -> str: ...
    @property
    def prefill(self) -> Mapping[str, Any]: ...
    @property
    def decode(self) -> Mapping[str, Any]: ...
    def canonical_bytes(self) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...
    def coverage(self, composition: Pipeline | None = None) -> DecoderCoverageReport: ...
    def runtime_schedule(self, composition: Pipeline) -> DecoderRuntimeSchedule: ...
    def apply(self, component: ComponentRef) -> ModelPlan: ...
    def continuation_schedule(self, composition: Pipeline) -> DecoderContinuationSchedule: ...

class DecoderContinuationSchedule:
    def __init__(self, _canonical_bytes: bytes, _source_plan: bytes, _composition: bytes) -> None: ...
    @property
    def digest(self) -> str: ...
    def canonical_bytes(self) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...
    def handshake_spec(self) -> dict[str, Any]: ...
    def admit(self, prefix: int, query: int, *, memory_bytes: int = ...) -> int: ...

class DecoderCoverageReport:
    def __init__(self, _canonical_bytes: bytes) -> None: ...
    @property
    def complete(self) -> bool: ...
    @property
    def operators(self) -> tuple[Mapping[str, Any], ...]: ...
    def canonical_bytes(self) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...

class DecoderRuntimeSchedule:
    def __init__(self, _canonical_bytes: bytes) -> None: ...
    @property
    def digest(self) -> str: ...
    @property
    def composition_digest(self) -> str: ...
    @property
    def complete(self) -> bool: ...
    @property
    def protected_execution(self) -> bool: ...
    @property
    def prefill(self) -> Mapping[str, Any]: ...
    @property
    def decode(self) -> Mapping[str, Any]: ...
    def canonical_bytes(self) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...

def lower_model(config: Mapping[str, Any] | bytes | str, *, batch: int, max_input_tokens: int, max_new_tokens: int) -> ModelPlan: ...

class ForwardPlan:
    def __init__(self, _canonical_bytes: bytes) -> None: ...
    @property
    def digest(self) -> str: ...
    @property
    def inputs(self) -> Mapping[str, Any]: ...
    @property
    def operations(self) -> tuple[Mapping[str, Any], ...]: ...
    @property
    def outputs(self) -> Mapping[str, Any]: ...
    @property
    def max_sequence(self) -> int: ...
    def canonical_bytes(self) -> bytes: ...
    def to_dict(self) -> dict[str, Any]: ...

def lower_forward_model(config: Mapping[str, Any] | bytes | str, *, max_sequence: int) -> ForwardPlan: ...
