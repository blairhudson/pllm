    def from_params(cls, params: Mapping[str, object]) -> Self: ...
    def get_params(self, deep: bool = True) -> dict[str, object]: ...
    @classmethod
    def describe(cls) -> ComponentDescriptor: ...

class AuthenticatedConfidentialRoleTransport(ComponentRef):
