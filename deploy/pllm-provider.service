[Unit]
Description=PLLM private matrix provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pllm
Group=pllm
WorkingDirectory=/opt/pllm
EnvironmentFile=/etc/pllm/provider.env
Environment=PYTHONUNBUFFERED=1
Environment=PLLM_NATIVE_CACHE=/var/cache/pllm/native
ExecStart=/opt/pllm/deploy/provider-start.sh
Restart=on-failure
RestartSec=5
CacheDirectory=pllm
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/cache/pllm

[Install]
WantedBy=multi-user.target
