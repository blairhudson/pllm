# Copy to /etc/pllm/provider.env with mode 0600 and fill the credential before starting.
# Do not commit the completed file. A missing credential fails startup.
PLLM_API_KEY=
PLLM_PROVIDER_PUSH_API_KEY=
PLLM_RENDEZVOUS_TIMEOUT=30
PLLM_RENDEZVOUS_CAPACITY=32768
PLLM_RENDEZVOUS_MAX_BYTES=268435456
PLLM_MODEL_SOURCE=/srv/models/checkpoint
PLLM_MODEL_ID=private-model
