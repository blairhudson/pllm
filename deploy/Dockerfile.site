FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY docs/ ./docs/
COPY paper/whitepaper.tex ./paper/whitepaper.tex
WORKDIR /app/docs
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
RUN npm run check:content && npm test && npm run typecheck && npm run build
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY deploy/nginx-site.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/docs/out /usr/share/nginx/html
EXPOSE 8080
