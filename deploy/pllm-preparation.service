[Unit]
Description=PLLM trusted preparation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pllm
Group=pllm
WorkingDirectory=/opt/pllm
EnvironmentFile=/etc/pllm/preparation.env
Environment=PYTHONUNBUFFERED=1
Environment=PLLM_NATIVE_CACHE=/var/cache/pllm-preparation/native
ExecStart=/opt/pllm/deploy/preparation-start.sh
Restart=on-failure
RestartSec=5
CacheDirectory=pllm-preparation
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/cache/pllm-preparation

[Install]
WantedBy=multi-user.target
