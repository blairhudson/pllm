# Copy to /etc/pllm/preparation.env with mode 0600 and use a distinct credential.
# Do not place this service under the untrusted inference operator.
PLLM_API_KEY=
PLLM_INFERENCE_URL=https://inference.example.com
PLLM_PUSH_API_KEY=
PLLM_PUSH_TIMEOUT=10
PLLM_MODEL_SOURCE=/srv/models/checkpoint
PLLM_MODEL_ID=private-model
