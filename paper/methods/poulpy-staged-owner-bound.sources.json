  "independent_integer_replay_python": [
    "N=65536; M=1<<20; cap=8<<30",
    "Z=lambda c,s:N*c*s*8",
    "D=lambda c,s:N*c*s*32",
    "G=lambda c,s:N*c*s*16",
    "P=N*7*2*33*32; R=P//4; low=N*2*3*8",
    "B=4*D(2,27); C=2*sum(n*d*32 for n,d in [(65536,16),(4096,31),(256,31),(16,15)])",
    "W=5*Z(2,28)+Z(2,1); T=2*2*64*sum(1<<i for i in range(17)); guard=64*M",
    "def branch(pt):",
    "    prod=28+pt; lazy=max(33,prod); mask=min(prod,33); digit=min((mask+3)//4,7)",
    "    gadget=D(1,digit)+(16+8*digit)*8",
    "    inner=8*16*prod*8",
    "    rot=D(1,mask)+G(1,prod)+Z(1,mask)+D(1,1)+D(2,33)+gadget",
    "    return Z(2,28)+D(2,prod)+D(2,lazy)+inner+D(2,33)+rot+G(2,lazy)",
    "common=7*P+B+C+W+T+guard",
    "assert branch(28)==1055449664 and common+branch(28)==8614894912",
    "assert branch(28)-Z(2,1)==1054401088",
    "assert common+branch(28)-Z(2,1)==8613846336",
    "assert common+branch(28)-Z(2,1)-cap==23911744>0",
    "assert branch(1)==758675008 and common+branch(1)==8318120256",
    "assert cap-common-branch(1)==271814336",
    "assert common+branch(1)+R==8560341312 and cap-common-branch(1)-R==29593280",
    "assert P-(cap-common-branch(1))==697069888",
    "assert 7*66==462 and 7*462*(8*N*4)==6782189568",
    "assert (138*462+2*6)*(8*N*4)==133731188736",
    "assert 4*sum(((16*(1<<i)+63)//64)*64 for i in range(16))==4194560",
    "assert 2*16*((1<<16)-1-16)==2096608",
    "assert (5+5+2+2)*Z(2,28)+D(2,28)==528482304",
    "assert 2*16-1==30+1 and ((31+2-1)//2).bit_length()==(30).bit_length()",
    "assert [(31+m-1)//2 for m in (0,1)]==[15,15] and (32+1)**2==1089",
    "def min_split(degree):",
    "    b=degree.bit_length(); s=b//2",
    "    a=(1<<s)+(1<<(b-s))+b-s-3; z=(1<<(s+1))+(1<<(b-s-1))+b-s-4",
    "    return s+1 if a>z else s",
    "babies=[]",
    "def decompose(d,s,maximum,lead):",
    "    if d<(1<<s):",
    "        if lead and d>0 and s>1 and maximum>(1<<maximum.bit_length())-(1<<(s-1)) and min_split(d)<s:",
    "            return decompose(d,min_split(d),maximum,lead)",
    "        babies.append(d); return",
    "    power=1<<s",
    "    while power<(d//2)+1: power*=2",
    "    decompose(power-1,s,maximum,False); decompose(d-power,s,maximum,lead)",
    "decompose(15,min_split(15),15,True)",
    "assert babies==[3,3,3,1,1]",
    "glwe=2*Z(1,33)+D(1,33)+G(1,33)+3*N*16",
    "gglwe=Z(1,33)+glwe",
    "assert glwe==141557760 and gglwe==158859264",
    "assert gglwe+D(1,1)+Z(1,1)==161480704",
    "assert gglwe+D(1,1)+2*Z(1,1)==162004992",
    "tensor=gglwe+2*D(1,1)+Z(1,1)",
    "extra=2*D(1,1)+G(1,1)+3*N*16; secrets=2*(Z(1,1)+D(1,1))",
    "assert tensor==163577856 and extra==8388608 and secrets==5242880",
    "assert R+tensor+extra+secrets==419430400",
    "assert (7+4-1)//4==2 and N*2*2*33*8==69206016",
    "noise=4+8+9+4+8+8+2*8; generic=noise+12+48; special=generic+8",
    "assert generic==117 and special==125",
    "assert 35*R+low+33*special+generic+2*special==8480887180",
    "assert 138*R+2*low+2*(67*special+generic+2*special)==33432814668"
