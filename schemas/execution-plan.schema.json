{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pllm.run/schemas/execution-plan.schema.json",
  "title": "PLLM execution plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "logical_plan_digest", "target", "components", "conversions", "role_plans", "material_requests", "resource_forecast", "evidence_references"],
  "properties": {
    "schema_version": {"const": "pllm.execution_plan.v1"},
    "logical_plan_digest": {"$ref": "#/$defs/digest"},
    "target": {"$ref": "#/$defs/namedDigest"},
    "components": {"type": "array", "items": {"$ref": "#/$defs/resolvedComponent"}, "uniqueItems": true},
    "conversions": {"type": "array", "items": {"$ref": "#/$defs/namedDigest"}, "uniqueItems": true},
    "role_plans": {"type": "array", "items": {"$ref": "#/$defs/rolePlan"}, "minItems": 1, "uniqueItems": true},
    "material_requests": {"type": "array", "items": {"$ref": "#/$defs/namedDigest"}, "uniqueItems": true},
    "resource_forecast": {"$ref": "#/$defs/namedDigest"},
    "evidence_references": {"type": "array", "items": {"$ref": "#/$defs/namedDigest"}, "uniqueItems": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "namedDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {"id": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "resolvedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "component", "version", "artifact_digest"],
      "properties": {
        "slot": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "rolePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "digest"],
      "properties": {"role": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
