{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pllm.run/schemas/provider-manifest.schema.json",
  "title": "PLLM provider manifest",
  "type": "object",
  "required": [
    "schema",
    "provider",
    "distribution",
    "version",
    "host_versions",
    "category_versions",
    "components",
    "schemas",
    "docs",
    "native_artifacts",
    "python_factories",
    "tested_builds"
  ],
  "properties": {
    "schema": {"const": "pllm.provider_manifest.v1"},
    "provider": {"$ref": "#/$defs/identity"},
    "distribution": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "host_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}
    },
    "category_versions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identity"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "schemas": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    },
    "docs": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    },
    "native_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/nativeArtifact"}
    },
    "python_factories": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/identity"},
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "tested_builds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["python", "platform", "architecture", "host_version"],
        "properties": {
          "python": {"type": "string", "minLength": 1, "maxLength": 64},
          "platform": {"type": "string", "minLength": 1, "maxLength": 64},
          "architecture": {"type": "string", "minLength": 1, "maxLength": 64},
          "host_version": {"type": "string", "pattern": "^[1-9][0-9]*$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "resource": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "nativeArtifact": {
      "type": "object",
      "required": ["path", "sha256", "abi_version", "targets"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "abi_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "component",
        "provider",
        "distribution",
        "version",
        "category",
        "category_version",
        "lifecycle_phase",
        "parameter_schema",
        "capabilities",
        "required_host_features",
        "role_eligibility",
        "artifacts",
        "evidence"
      ],
      "properties": {
        "component": {"$ref": "#/$defs/identity"},
        "provider": {"$ref": "#/$defs/identity"},
        "distribution": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "category": {"$ref": "#/$defs/identity"},
        "category_version": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "lifecycle_phase": {"type": "string", "minLength": 1, "maxLength": 64},
        "parameter_schema": {"type": ["object", "boolean"]},
        "capabilities": {"$ref": "#/$defs/identities"},
        "required_host_features": {"$ref": "#/$defs/identities"},
        "role_eligibility": {"$ref": "#/$defs/identities"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/resource"}},
        "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "identities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    }
  }
}
