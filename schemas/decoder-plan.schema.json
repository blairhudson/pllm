{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pllm.run/schemas/decoder-plan.schema.json",
  "title": "PLLM decoder model plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_family", "adapter", "config_digest", "transformations", "prefill", "decode", "token_feedback"],
  "properties": {
    "schema_version": {"const": "pllm.decoder_plan.v1"},
    "model_family": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "pattern": "^pllm\\.[a-z0-9_.-]+\\.v[0-9]+$"},
    "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
    "prefill": {"$ref": "#/$defs/graph"},
    "decode": {"$ref": "#/$defs/graph"},
    "token_feedback": {"const": true}
  },
  "$defs": {
    "transformation": {
      "type": "object", "additionalProperties": false,
      "required": ["component", "implementation", "method_id", "input_digest", "configuration_digest"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "method_id": {"type": "string", "minLength": 1},
        "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "batch", "query_sequence", "maximum_key_sequence", "operations", "state_inputs", "state_outputs", "output"],
      "properties": {
        "mode": {"enum": ["prefill", "decode"]},
        "batch": {"type": "integer", "minimum": 1},
        "query_sequence": {"type": "integer", "minimum": 1},
        "maximum_key_sequence": {"type": "integer", "minimum": 1},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
        "state_inputs": {"type": "array", "items": {"$ref": "#/$defs/state"}},
        "state_outputs": {"type": "array", "items": {"$ref": "#/$defs/state"}},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "layer", "state_kind", "inputs", "output_shape", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
        "operator": {"enum": ["token_lookup", "reshape", "rms_norm", "linear", "rotary_embedding", "kv_cache_append", "attention_scores", "attention_scale", "causal_mask", "softmax", "attention_values", "residual_add", "silu", "multiply", "last_token", "output_head", "greedy_token_selection", "token_feedback", "attention_importance", "secure_top_k", "secure_gather", "cluster_bounds", "cluster_similarity", "shared_indices", "cache_active_indices", "scale", "slice", "gelu_tanh", "softcap", "cache_suffix", "permute", "sigmoid", "gated_delta_decay", "causal_convolution", "convolution_state_update", "gated_delta_rule", "gated_delta_state_update", "rms_norm_gated"]},
        "layer": {"type": ["integer", "null"], "minimum": 0},
        "state_kind": {"type": ["string", "null"], "enum": ["key", "value", "cache_indices", "recurrent", "convolution", null]},
        "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "output_shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "attributes": {"type": "object"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "layer", "kind", "shape", "maximum_sequence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "layer": {"type": ["integer", "null"], "minimum": 0},
        "kind": {"enum": ["key", "value", "cache_indices", "recurrent", "convolution"]},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "maximum_sequence": {"type": "integer", "minimum": 0}
      }
    }
  }
}
