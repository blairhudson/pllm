{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pllm.run/schemas/publication-assessment.schema.json",
  "title": "PLLM publication assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "inputs", "claim", "axes", "decision", "reason_codes", "citations", "publication_metadata"],
  "properties": {
    "schema_version": {"const": "pllm.publication_assessment.v1"},
    "policy": {"type": "object"},
    "inputs": {"type": "array"},
    "claim": {"$ref": "claim-record.schema.json"},
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "method", "plan_lineage", "benchmark", "assurance", "claim"],
      "properties": {
        "source": {"$ref": "#/$defs/axis"},
        "method": {"$ref": "#/$defs/axis"},
        "plan_lineage": {"$ref": "#/$defs/axis"},
        "benchmark": {"$ref": "#/$defs/axis"},
        "assurance": {"$ref": "#/$defs/axis"},
        "claim": {"$ref": "#/$defs/axis"}
      }
    },
    "decision": {"enum": ["blocked", "ready_for_human_review"]},
    "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "citations": {"type": "array"},
    "publication_metadata": {"type": "object"}
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supporting_inputs"],
      "properties": {
        "status": {"enum": ["satisfied", "missing", "blocked", "not_applicable"]},
        "supporting_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
