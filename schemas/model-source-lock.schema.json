{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pllm.run/schemas/model-source-lock.schema.json",
  "title": "PLLM model source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "repo_id", "revision", "commit", "files", "checkpoint_digest"],
  "properties": {
    "schema": {"const": "pllm.model_source_lock.v1"},
    "kind": {"enum": ["huggingface", "safetensors", "vllm", "mlx", "mlx-lm", "gguf", "llama.cpp", "tiny"]},
    "repo_id": {"type": ["string", "null"]},
    "revision": {"type": ["string", "null"]},
    "commit": {"type": ["string", "null"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[^/]+$"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
