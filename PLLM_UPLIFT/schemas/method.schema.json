{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_ids",
    "input_representations",
    "output_representation",
    "online_roles",
    "preparation_phase",
    "native_owner",
    "status",
    "assurance_obligations",
    "eligible_default"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_representations": {
      "type": "array",
      "items": {
        "enum": [
          "Public",
          "ClientPlaintext",
          "MaskedRing",
          "ArithmeticLabel",
          "BooleanLabel",
          "AdditiveShare",
          "Ciphertext",
          "AttestedPlaintext"
        ]
      }
    },
    "output_representation": {
      "enum": [
        "Public",
        "ClientPlaintext",
        "MaskedRing",
        "ArithmeticLabel",
        "BooleanLabel",
        "AdditiveShare",
        "Ciphertext",
        "AttestedPlaintext"
      ]
    },
    "online_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "preparation_phase": {
      "enum": [
        "none",
        "offline",
        "online",
        "source_acquisition_required"
      ]
    },
    "native_owner": {
      "const": "Rust"
    },
    "status": {
      "enum": [
        "planned",
        "source_provided_uncompiled",
        "reference_operator",
        "native_operator",
        "region",
        "full_model"
      ]
    },
    "assurance_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eligible_default": {
      "type": "boolean"
    }
  }
}
