{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "outcome",
    "scope",
    "origin",
    "implementation_refinement",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": {
      "const": "pllm.claim_result.v1"
    },
    "claim_id": {
      "type": "string"
    },
    "outcome": {
      "enum": [
        "proved_in_model",
        "refuted_in_scope",
        "not_refuted",
        "inconclusive",
        "outside_contract",
        "unchecked"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "solver_executed",
        "adversary_executed",
        "source_reported",
        "human_review",
        "not_run"
      ]
    },
    "implementation_refinement": {
      "enum": [
        "not_established",
        "tested_differential",
        "proved_for_locked_code"
      ]
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "solver_or_tool_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "code_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
