{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "logical_hash",
    "execution_hash",
    "model_hash",
    "numeric_hash",
    "method_versions",
    "kernel_versions",
    "conversion_versions",
    "compiler_commit",
    "privacy_contract_hash",
    "public_workload_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "pllm.plan_lock.v1"
    },
    "logical_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "numeric_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "privacy_contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "public_workload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "kernel_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "conversion_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "compiler_commit": {
      "type": "string",
      "minLength": 1
    }
  }
}
