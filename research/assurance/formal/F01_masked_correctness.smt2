(set-option :timeout 10000)

(set-logic QF_BV)
(declare-const w (_ BitVec 8))
(declare-const x (_ BitVec 8))
(declare-const r (_ BitVec 8))
(declare-const s (_ BitVec 8))
(define-fun c () (_ BitVec 8) (bvsub (bvmul w r) s))
(define-fun u () (_ BitVec 8) (bvsub x r))
(define-fun v () (_ BitVec 8) (bvadd (bvmul w u) c))
(assert (not (= (bvadd v s) (bvmul w x))))
(check-sat)
